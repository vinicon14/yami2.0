      "capabilities": [
        { "id": "email", "name": "Ler e-mails Outlook", "scope": "Mail.Read" },
        { "id": "calendar", "name": "Consultar agenda", "scope": "Calendars.Read" },
        { "id": "onedrive", "name": "Buscar arquivos OneDrive", "scope": "Files.Read" }
