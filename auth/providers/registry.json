      "id": "google",
      "name": "Google",
      "icon": "G",
      "iconClass": "g",
      "category": "email-calendar",
      "description": "Gmail, Google Agenda, Google Fotos, Google Drive e mais",
      "color": "#4285f4",
      "authType": "oauth2",
      "authUrl": "https://accounts.google.com/o/oauth2/auth",
      "tokenUrl": "https://oauth2.googleapis.com/token",
      "scopes": [
        "https://www.googleapis.com/auth/gmail.readonly",
        "https://www.googleapis.com/auth/calendar.readonly",
        "https://www.googleapis.com/auth/drive.readonly",
        "https://www.googleapis.com/auth/photoslibrary.readonly"
      ],
      "capabilities": [
        { "id": "email", "name": "Ler e-mails", "scope": "https://www.googleapis.com/auth/gmail.readonly" },
        { "id": "calendar", "name": "Consultar agenda", "scope": "https://www.googleapis.com/auth/calendar.readonly" },
        { "id": "drive", "name": "Buscar arquivos", "scope": "https://www.googleapis.com/auth/drive.readonly" },
        { "id": "photos", "name": "Gerenciar fotos", "scope": "https://www.googleapis.com/auth/photoslibrary.readonly" }
      ],
      "enabled": true
    },
    {
      "id": "microsoft",
      "name": "Microsoft",
      "icon": "M",
      "iconClass": "m",
      "category": "email-calendar",
