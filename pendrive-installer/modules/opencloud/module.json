{
  "id": "opencloud-sync",
  "name": "OpenCloud Sync Adapter",
  "version": "1.0.0",
  "source": "opencloud-sync",
  "license": "MIT",
  "adapted": true,
  "description": "Cloud sync and identity management adapted from OpenCloud. Handles multi-device identity, profile roaming, and encrypted storage sync.",
  "capabilities": ["sync-engine", "identity-management", "storage-sync"],
  "dependencies": ["openclaw-adapter"],
  "compatibility": ["yami-pendrive-1.0", "opencloud-2026"],
  "modules": [
    {"id": "sync", "name": "Yami Sync", "purpose": "Multi-device state synchronization"},
    {"id": "identity", "name": "Yami Identity", "purpose": "Device identity and pairing"},
    {"id": "storage", "name": "Yami Storage", "purpose": "Encrypted profile and data storage"}
  ],
  "config": {
    "syncEnabled": true,
    "syncIntervalMinutes": 15,
    "encryption": "aes-256-gcm"
  }
}
