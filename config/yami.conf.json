{
  "app": {
    "name": "YAMI",
    "version": "0.1.0",
    "debug": true
  },
  "voice": {
    "enabled": true,
    "wake_word": "yami",
    "wake_word_sensitivity": 0.5,
    "language": "pt-BR",
    "sample_rate": 16000,
    "chunk_size": 1024
  },
  "tts": {
    "engine": "pyttsx3",
    "language": "pt-BR",
    "rate": 150,
    "volume": 0.9
  },
  "ui": {
    "theme": "dark",
    "avatar_style": "minimal",
    "avatar_size": 128,
    "animation_enabled": true,
    "position": "bottom-right"
  },
  "llm": {
    "type": "openclaw",
    "local_model": true,
    "model_name": "openclaw-7b",
    "temperature": 0.7,
    "max_tokens": 512,
    "context_window": 4096
  },
  "database": {
    "type": "sqlite",
    "path": "data/yami.db",
    "auto_backup": true,
    "backup_interval": 3600
  },
  "integrations": {
    "whatsapp": {
      "enabled": false,
      "api_version": "v17.0"
    },
    "calendar": {
      "enabled": false,
      "provider": "google"
    },
    "file_manager": {
      "enabled": true,
      "index_enabled": true
    }
  },
  "automation": {
    "enabled": true,
    "habit_learning": true,
    "codex_integration": false
  },
  "privacy": {
    "encrypt_data": true,
    "encrypt_credentials": true,
    "allow_remote_access": false,
    "telemetry_enabled": false
  },
  "logging": {
    "level": "INFO",
    "file": "logs/yami.log",
    "max_size": 10485760,
    "backup_count": 5
  }
}
