# YAMI Configuration - Copy to .env and fill with your values

# OpenAI / OpenClaw Configuration
OPENAI_API_KEY=your_api_key_here
OPENAI_ORG_ID=

# Local Model Configuration
USE_LOCAL_MODEL=true
LOCAL_MODEL_PATH=./models/openclaw-7b

# WhatsApp Integration
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=

# Google Calendar Integration
GOOGLE_CALENDAR_CREDENTIALS=./config/google_credentials.json

# Database
DATABASE_PATH=./data/yami.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/yami.log

# Debug Mode
DEBUG=false

# Voice Configuration
VOICE_LANGUAGE=pt-BR
VOICE_RATE=150

# Theme
THEME=dark
